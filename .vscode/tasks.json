{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "main.cpp",
                "src/DistortionEngine.cpp",
                "src/ControlEngine.cpp",
                "src/ReverbEngine.cpp",
                "-o",
                "${workspaceFolder}/Builds/Guitfx",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/include/Effects",
                "-lportaudio"
                
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}